{
  "name": "pulse-mini-seed",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:*\"",
    "dev:auth": "npm --workspace services/auth-gateway run dev",
    "dev:tickets": "npm --workspace services/tickets-api run dev",
    "dev:notif": "npm --workspace services/notifications-worker run dev",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20"
  }
}
